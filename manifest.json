{
  "manifest_version": 3,
  "name": "Steam Group Manager",
  "version": "1.3.0",
  "description": "Manage Steam group members: send friend requests, clear existing friend nicknames, and apply group nicknames.",
  "permissions": [
  "storage",
  "tabs",
  "cookies"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "http://localhost:5500/*",
    "http://127.0.0.1:5500/*",
    "https://verceladd.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5500/*",
        "http://127.0.0.1:5500/*",
        "https://verceladd.xyz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}